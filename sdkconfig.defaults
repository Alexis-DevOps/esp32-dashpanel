CONFIG_IDF_TARGET="esp32s3"

# Waveshare ESP32-S3-LCD-Driver-Board: ESP32-S3-WROOM-1-N8R8 (8 MB flash, 8 MB octal PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Run code/rodata from PSRAM so flash ops don't stall the RGB LCD DMA
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# Logs over the native USB port (/dev/ttyACM0)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_DEF_REFR_PERIOD=20

# Keep the RGB LCD bounce-buffer ISR in IRAM so it never waits on PSRAM/flash cache misses
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# Espressif's recommendation for RGB panels with PSRAM frame buffers: bigger cache, 64-byte lines
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Performance monitor (FPS / CPU) printed to the serial log
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_PERF_MONITOR_LOG_MODE=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y

# Espressif LVGL performance guide: hot LVGL functions in IRAM, faster flash bus
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# 1 ms RTOS tick: LVGL's 20 ms timers otherwise get rounded to 10 ms steps (-> ~33 FPS)
CONFIG_FREERTOS_HZ=1000
